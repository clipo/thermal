# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Data files (too large for git)
data/
*.irg
*.TIFF
*.tiff
*.JPG
*.jpg
*.png

# Allow documentation images
!docs/
!docs/images/
!docs/images/*.png

# Output directories
sgd_output/
ocean_output/

# Alignment and config files (user-specific)
thermal_alignment.json
sgd_detections.geojson

# Cache and temporary files
*_cache.pkl
exif_analysis.json
sgd_aggregate.json
temporal_data_cache.pkl

# User-generated config files (keep templates)
sgd_config.json
my_*.json
!configs/*.json

# SAM prompts (user-specific, but keep examples and README)
prompts/*.json
!prompts/example_*.json
!prompts/README.md

# SAM model checkpoints (large files)
models/sam/*.pth

# Per-flight derived flat-fields (regenerated from data; not source of truth)
models/flat_fields/

# Claude Code session state (local only)
.claude/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Keep sample data directory structure
!data/.gitkeep
# Word/Excel lock files
~$*

# Top-level test data (not part of pipeline)
test_search/
